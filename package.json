{
  "name": "camelclipper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "vue-tsc && vite build",
    "build:docs": "vue-tsc && vite build --outDir ./docs --emptyOutDir --base ./",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.184.0",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.3"
  }
}
